# CortexClip Backend (OpenShorts-inspired pipeline)
# Environment

# Supabase (self-hosted on this VPS)
SUPABASE_URL=http://178.128.82.140:8000
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Hydra AI providers (comma-separated keys allowed per provider: k1,k2)
GEMINI_API_KEYS=
GROQ_API_KEYS=
OPENCODE_API_KEYS=
OPENROUTER_API_KEYS=
TOKENROUTER_API_KEYS=

# Pipeline
MAX_CONCURRENT_JOBS=2
OUTPUT_DIR=/root/cortexclip/backend/output
UPLOAD_DIR=/root/cortexclip/backend/uploads

# ── Provider gratis tambahan (riset docs/riset-ai-gratis-2026-09.md) ──
# Kosong = dilewati Hydra. Isi untuk menambah kapasitas gratis:
#   Cloudflare Workers AI: 10.000 Neuron/hari permanen (butuh ACCOUNT_ID)
#   NVIDIA NIM: 40 RPM gratis, termasuk VLM Qwen2.5-VL-72B
CLOUDFLARE_API_KEYS=
CLOUDFLARE_ACCOUNT_ID=
NVIDIA_API_KEYS=
